function handler(event) {
  var request = event.request;
  var domain = ${canonical_domain};
  if (domain && request.headers.host.value !== domain) {
    var query = [];
    Object.keys(request.querystring).forEach(function (key) {
      var entries = request.querystring[key].multiValue || [request.querystring[key]];
      entries.forEach(function (entry) {
        query.push(key + '=' + entry.value);
      });
    });
    return {
      statusCode: 302,
      headers: { location: { value: 'https://' + domain + request.uri + (query.length ? '?' + query.join('&') : '') } }
    };
  }
  if (request.uri === '/' || request.uri === '/design-system' || request.uri === '/admin/access' || request.uri.indexOf('/g/') === 0) {
    request.uri = '/index.html';
  }
  return request;
}
